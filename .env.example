# Template de variáveis de ambiente — copie para .env e preencha.
#   cp .env.example .env
#
# O .env não é versionado (ver .gitignore). Nunca commite valores reais.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. A publishable key é PÚBLICA por design: ela vai
# embutida no bundle do navegador via VITE_*. NÃO use esta chave como segredo
# de endpoint — qualquer visitante pode lê-la no DevTools.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Mesmos valores, expostos ao cliente pelo Vite (devem ser idênticos aos acima).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA expor ao cliente nem commitar. Só use em código *.server.ts ou handlers.
# Necessária para rotinas administrativas (ex.: classify_abc via cron).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Crones (HMAC-SHA256) ────────────────────────────────────────────────────
# Cada endpoint /api/public/cron/* tem o próprio segredo e o próprio header de
# assinatura. Gere com:  openssl rand -hex 32
#
# /api/public/cron/launch-performance  → header x-launch-signature
LAUNCH_CRON_SECRET=
# /api/public/cron/abc-classify        → header x-abc-signature
ABC_CRON_SECRET=

# ─── IA ──────────────────────────────────────────────────────────────────────
# Gateway usado por /api/generate-image e pelos agentes de IA.
LOVABLE_API_KEY=

# ─── Comportamento de UI (público, VITE_ vai para o bundle) ─────────────────
# Self-cadastro na tela /login. "true" habilita a aba "Criar conta"; qualquer
# outro valor (ou ausente) esconde — produto de acesso restrito, cadastro por
# convite do admin. Em produção o gate real é o toggle "Allow new sign ups" do
# Supabase Auth; isto só controla a UI.
VITE_ALLOW_SELF_SIGNUP=false
