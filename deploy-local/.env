# Porta do gateway local. 8080 colide com sistemas comuns (Tomcat, Jenkins...),
# entao o pacote usa 18080. Para escolher outra: mude AS DUAS linhas abaixo e
# rode o .bat de novo — o build do web consome APP_URL como arg do Docker e e
# refeito sozinho; dados no Postgres NAO sao tocados.
APP_URL=http://localhost:18080
APP_PORT=18080
