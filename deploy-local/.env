# Config do pacote LOCAL. As CHAVES/segredos nao moram mais aqui — estao como
# literais no docker-compose.yml, porque .env editado no Bloco de Notas ganha
# CRLF e o \r vazava para dentro das DSN (fatal "invalid userinfo" no GoTrue).
# Estas duas linhas o plm-local.bat le para escolher a porta do navegador:
# Porta do gateway local. 8080 colide com sistemas comuns (Tomcat, Jenkins...),
# entao o pacote usa 18080. Para escolher outra: mude as duas linhas abaixo,
# rode o .bat de novo — o build do web usa APP_PORT como arg e e refeito.
APP_PORT=18080
APP_URL=http://localhost:18080
